{
  "name": "halo-rc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo build && (rm -rf .next && ln -s apps/web/.next .next || true)",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "db:generate": "turbo db:generate",
    "db:migrate": "node scripts/migrate-supabase.mjs",
    "db:seed": "node scripts/seed-supabase.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "next": "15.5.25",
    "turbo": "latest",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  }
}
