# ── Supabase PostgreSQL Database (Node.js runtime authoritative)
# Transaction pooler connection string for Drizzle ORM and migrations
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Supabase Client & Auth
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Stripe Commerce (Phase 2)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Market Default Configuration
NEXT_PUBLIC_DEFAULT_MARKET=UK
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
